# Abhify cloud service (cloud/) - PLACEHOLDERS ONLY. Copy to cloud/deploy/.env (or set real environment
# variables / a secret manager on the server). Never commit a real .env, never put keys in the Android app.
ABHIFY_CLOUD_ENV=dev
ABHIFY_CLOUD_PUBLIC_URL=https://api.your-domain.example

# Optional: administrator-managed shared provider access (OFF unless true). Keys stay on the server only.
ABHIFY_CLOUD_SHARED_ENABLED=false
ABHIFY_CLOUD_SHARED_ORDER=gemini,groq,openrouter
ABHIFY_CLOUD_SHARED_GEMINI_KEY=
ABHIFY_CLOUD_SHARED_GROQ_KEY=
ABHIFY_CLOUD_SHARED_OPENROUTER_KEY=
ABHIFY_CLOUD_SHARED_GEMINI_MODEL=gemini-3.8-flash
ABHIFY_CLOUD_SHARED_GROQ_MODEL=llama-3.3-70b-versatile
ABHIFY_CLOUD_SHARED_OPENROUTER_MODEL=openrouter/free
ABHIFY_CLOUD_SHARED_DAILY_LIMIT=50
# true only if you accept that models outside the free tier may be charged to your accounts
ABHIFY_CLOUD_SHARED_ALLOW_CHARGED=false

# Password-reset email (required in production)
ABHIFY_CLOUD_SMTP_HOST=
ABHIFY_CLOUD_SMTP_PORT=587
ABHIFY_CLOUD_SMTP_USER=
ABHIFY_CLOUD_SMTP_PASSWORD=
ABHIFY_CLOUD_SMTP_FROM=
