# Copy to backend/.env and adjust. Every setting in config.py can be set here.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5
EMBED_MODEL=nomic-embed-text

# Where ChromaDB + SQLite are stored
# DATA_DIR=./data

# Whisper: tiny | base | small | medium | large-v3   /   auto | cuda | cpu
WHISPER_MODEL=base
WHISPER_DEVICE=auto

# Frontend origins allowed to call the API (comma separated). Use * only for testing.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
# CORS_ORIGIN_REGEX=https://.*\.(netlify|vercel)\.app
