# Python
.venv/
__pycache__/
*.pyc

# Local data (ChromaDB knowledge base + SQLite progress)
backend/data/

# Secrets / local config
backend/.env

# Logs
*.log

# Build outputs and download cache (large; published via GitHub Releases, not git)
build/
dist/
packaging/.cache/

# Signing material must never be committed
*.pfx
*.p12
*.key
*.pem

# Secrets: real .env files are never committed (placeholders live in .env.example)
.env
.env.*
!.env.example
**/.env

# Android app (4.x): build output, native intermediates (incl. downloaded llama.cpp sources), local SDK path, packages, keys
android/.gradle/
android/app/build/
android/app/.cxx/
android/**/build/
android/local.properties
*.apk
*.aab
*.jks
*.keystore
